# Postgres (Prisma)
DATABASE_URL="postgresql://mercury:PASSWORD@localhost:5432/mercury?schema=public"

# Secreto para firmar sesiones JWT (openssl rand -base64 32)
AUTH_SECRET="cambia-esto"

# Poner en 1 solo cuando haya HTTPS/TLS (cookie Secure)
COOKIE_SECURE="0"

# MinIO (S3-compatible) para media
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="mercury-media"
S3_ACCESS_KEY="cambia-esto"
S3_SECRET_KEY="cambia-esto"
# Base pública servida por nginx (proxy a MinIO)
S3_PUBLIC_BASE="/media"
